# ── Database ──────────────────────────────────────────────────────
TursoDbUrl=http://127.0.0.1:8080
TursoAuthToken=
TursoPlatformApiToken=
TursoOrgName=

# ── Auth ─────────────────────────────────────────────────────────
BetterAuthSecret=
BetterAuthUrl=http://localhost:3000
GoogleClientId=
GoogleClientSecret=
GithubClientId=
GithubClientSecret=

# ── MCP ──────────────────────────────────────────────────────────
McpJwtSecret=
McpAllowedOrigins=http://localhost:3000
McpInternalApiKey=

# ── Billing ──────────────────────────────────────────────────────
LemonsqueezyApiKey=
LemonsqueezyStoreId=
LemonsqueezyWebhookSecret=

# ── Analytics ────────────────────────────────────────────────────
PosthogKey=
PosthogHost=https://eu.i.posthog.com

# ── Demo voice service (sync these with infra/sync-secrets.sh) ───
DemoAdminToken=replace-with-a-long-random-operator-token
DemoAllowedDestination=
TwilioAccountSid=
TwilioAuthToken=
TwilioFromNumber=
OpenAiApiKey=

# ── Demo deployment configuration (not SST secrets) ─────────────
# Required for real Twilio WSS calls; use a Route 53-managed hostname.
KITSTACK_DEMO_VOICE_DOMAIN=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin

# ── Client-side (Next.js build-time, not SST secrets) ───────────
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

AWS_PROFILE=
