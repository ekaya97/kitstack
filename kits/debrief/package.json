{
  "name": "@kitstackco/debrief-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./kit.config": "./kit.config.ts"
  },
  "dependencies": {
    "@kitstackco/sdk": "*",
    "@libsql/client": "^0.14",
    "jose": "^5.2.3",
    "ws": "^8.18.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  },
  "scripts": {
    "build": "kitstack build",
    "publish:assets": "npm run build && sst shell -- npx tsx scripts/publish-assets.ts",
    "start": "tsx src/transports/server.ts",
    "start:stdio": "tsx src/transports/mcp/stdio.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts"
  }
}
