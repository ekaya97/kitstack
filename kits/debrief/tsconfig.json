{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "react", "vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@kitstackco/sdk": ["../../packages/sdk/src/index.ts"],
      "@kitstackco/sdk/*": ["../../packages/sdk/src/*"],
      "@kitstackco/voice": ["../../packages/voice/src/index.ts"]
    }
  },
  "include": ["src", "kit.config.ts", "test"]
}
