{
  "name": "kitstack",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "sst dev -- next dev web",
    "build": "next build web",
    "start": "next start web",
    "lint": "next lint web",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "dev:db": "turso dev --db-file databases/local.db",
    "db:seed": "tsx web/src/db/seed.ts",
    "postbuild": "next-sitemap --config web/next-sitemap.config.js",
    "upload:apps": "sst shell -- npx tsx packages/sdk/views/upload-apps.ts",
    "seed:registry": "sst shell -- npx tsx packages/mcp-server/src/scripts/seed-registry.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1035.0",
    "@aws-sdk/client-lambda": "^3.1035.0",
    "@aws-sdk/client-s3": "^3.1035.0",
    "@aws-sdk/lib-dynamodb": "^3.1035.0",
    "@aws-sdk/s3-request-presigner": "^3.1035.0",
    "@heroui/react": "^2",
    "@heroui/theme": "^2",
    "@lemonsqueezy/lemonsqueezy.js": "^4.0.0",
    "@libsql/client": "^0.14",
    "@modelcontextprotocol/ext-apps": "^1.7.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api-logs": "^0.215.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.215.0",
    "@opentelemetry/resources": "^2.7.0",
    "@opentelemetry/sdk-logs": "^0.215.0",
    "@tanstack/react-query": "^5",
    "better-auth": "^1",
    "drizzle-orm": "^0.38",
    "framer-motion": "^11",
    "gray-matter": "^4.0.3",
    "jose": "^6.2.2",
    "nanoid": "^5.1.9",
    "next": "^15",
    "next-mdx-remote": "^6.0.0",
    "next-sitemap": "^4",
    "posthog-js": "^1.371.2",
    "posthog-node": "^5.21.2",
    "react": "^19",
    "react-dom": "^19",
    "tsx": "^4.21.0",
    "zod": "^4.3.6",
    "zustand": "^5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@types/aws-lambda": "^8.10.161",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4",
    "autoprefixer": "^10",
    "aws-cdk-lib": "2.171.1",
    "constructs": "10.4.2",
    "drizzle-kit": "^0.30",
    "jsdom": "^25",
    "postcss": "^8",
    "sst": "^3",
    "tailwindcss": "^3",
    "typescript": "^5",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^2"
  },
  "description": "Two-tier AI tool platform: free skills (downloadable .zip) and subscription kits (persistent MCP apps). One connector, all your tools.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "author": "",
  "license": "ISC"
}