{
  "name": "kitstack",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "workspaces": [
    "web",
    "packages/sdk",
    "packages/mcp-server",
    "packages/authz",
    "kits/debrief"
  ],
  "scripts": {
    "dev": "sst dev",
    "test": "npm run test:all",
    "test:run": "npm run test:all",
    "test:all": "npm run test:debrief && npm run test:sdk && npm run test:mcp-server && npm run test:authz && npm run test:web",
    "test:debrief": "npm test --workspace @kitstackco/debrief-kit",
    "test:sdk": "npm test --workspace @kitstackco/sdk",
    "test:mcp-server": "npm test --workspace @kitstackco/mcp-server",
    "test:authz": "npm test --workspace @kitstackco/authz",
    "test:web": "npm test --workspace kitstack-web",
    "demo:server": "npm run start --workspace @kitstackco/debrief-kit",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx web/src/db/seed.ts",
    "dev:db": "turso dev --db-file databases/local.db",
    "build:layer": "packages/sdk/layer/build.sh",
    "sync:secrets": "./infra/sync-secrets.sh",
    "deploy:kit": "sst shell -- npx tsx"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudwatch": "^3.1037.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1038.0",
    "@aws-sdk/client-sns": "^3.1037.0",
    "@types/node": "^22.0.0",
    "aws-cdk-lib": "2.171.1",
    "aws-sdk-client-mock": "^4.1.0",
    "constructs": "10.4.2",
    "drizzle-kit": "^0.30",
    "sst": "4.12.11",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^2"
  }
}
