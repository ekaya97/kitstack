{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@kitstackco/sdk": ["../sdk/src/index.ts"],
      "@kitstackco/sdk/*": ["../sdk/src/*"]
    }
  },
  "include": ["src", "tests"]
}
