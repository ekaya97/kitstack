{
  "name": "@kitstackco/sdk",
  "version": "0.1.1",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "bin": {
    "kitstack": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./view": "./views/src/shared/use-kit.ts",
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./tailwind-preset": {
      "types": "./dist/tailwind-preset.d.ts",
      "default": "./dist/tailwind-preset.js"
    },
    "./deploy/upload": {
      "types": "./dist/deploy/upload.d.ts",
      "default": "./dist/deploy/upload.js"
    },
    "./deploy/seed-registry": {
      "types": "./dist/deploy/seed-registry.d.ts",
      "default": "./dist/deploy/seed-registry.js"
    },
    "./deploy/deploy-lambda": {
      "types": "./dist/deploy/deploy-lambda.d.ts",
      "default": "./dist/deploy/deploy-lambda.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "views/",
    "layer/",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.38.0",
    "zod": "^3.22.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "@vitejs/plugin-react": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "dependencies": {
    "esbuild": "^0.24.0",
    "picocolors": "^1.1.0",
    "tsx": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0"
  }
}
